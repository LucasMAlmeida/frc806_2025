package frc.robot;

import com.ctre.phoenix.motorcontrol.can.TalonFX;
import com.ctre.phoenix.motorcontrol.TalonFXControlMode;
import edu.wpi.first.wpilibj.AnalogInput;
import edu.wpi.first.wpilibj.TimedRobot;
import edu.wpi.first.wpilibj.smartdashboard.SmartDashboard;

public class Robot extends TimedRobot {
    // Elevator motor
    private final TalonFX elevatorMotor = new TalonFX(4); // Replace with actual CAN ID
    private final AnalogInput elevatorEncoder = new AnalogInput(0); // Replace with actual analog port

    // Arm motor
    private final TalonFX armMotor = new TalonFX(5); // Replace with actual CAN ID
    private final AnalogInput armEncoder = new AnalogInput(1); // Replace with actual analog port

    @Override
    public void teleopPeriodic() {
        // Read absolute positions
        double elevatorPosition = getAbsoluteEncoderDegrees(elevatorEncoder);
        double armPosition = getAbsoluteEncoderDegrees(armEncoder);

        // Output for debugging
        SmartDashboard.putNumber("Elevator Position", elevatorPosition);
        SmartDashboard.putNumber("Arm Position", armPosition);

        // Example: Move to position (replace with real control logic)
        double desiredElevatorPosition = 50.0; 
      // Example target
        double elevatorError = desiredElevatorPosition - elevatorPosition;
        double elevatorSpeed = elevatorError * 0.01; // Simple P control

        elevatorMotor.set(TalonFXControlMode.PercentOutput, elevatorSpeed);
    }

    // Converts through-bore encoder voltage to degrees (assuming 0-5V = 0-360°)
    private double getAbsoluteEncoderDegrees(AnalogInput encoder) {
        return (encoder.getVoltage() / 5.0) * 360.0;
    }
}
